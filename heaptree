#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int *arr;
    int size;
    int capacity;
} MaxHeap;

MaxHeap* createHeap(int capacity) {
    MaxHeap *heap = (MaxHeap*)malloc(sizeof(MaxHeap));
    heap->capacity = capacity;
    heap->size = 0;
    heap->arr = (int*)malloc(capacity * sizeof(int));
    return heap;
}

void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}


void heapify(MaxHeap *heap, int index) {
    int largest = index;
    int left = 2 * index + 1;
    int right = 2 * index + 2;

    
    if (left < heap->size && heap->arr[left] > heap->arr[largest]) {
        largest = left;
    }

        if (right < heap->size && heap->arr[right] > heap->arr[largest]) {
        largest = right;
    }

    
    if (largest != index) {
        swap(&heap->arr[index], &heap->arr[largest]);
        heapify(heap, largest);
    }
}


void insert(MaxHeap *heap, int value) {
    if (heap->size == heap->capacity) {
        printf("Heap is full\n");
        return;
    }

    heap->arr[heap->size] = value;
    heap->size++;

   
    int i = heap->size - 1;
    while (i != 0 && heap->arr[(i - 1) / 2] < heap->arr[i]) {
        swap(&heap->arr[i], &heap->arr[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

void deleteMax(MaxHeap *heap) {
    if (heap->size <= 0) {
        printf("Heap is empty\n");
        return;
    }
    heap->arr[0] = heap->arr[heap->size - 1];
    heap->size--;

   
    heapify(heap, 0);
}

void display(MaxHeap *heap) {
    if (heap->size == 0) {
        printf("Heap is empty\n");
        return;
    }

    for (int i = 0; i < heap->size; i++) {
        printf("%d ", heap->arr[i]);
    }
    printf("\n");
}

int main() {
    int capacity, choice, value, n;

    printf("Enter the capacity of the heap: ");
    scanf("%d", &capacity);

    MaxHeap *heap = createHeap(capacity);

    while (1) {
        printf("\nMenu:\n");
        printf("1. Insert element\n");
        printf("2. Delete max element\n");
        printf("3. Display heap\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                 printf("Enter the number of values you want to insert:");
            scanf("%d",&n);
                //printf("Enter the value to insert: ");
                for(int i=0;i<n;i++){
                printf("Enter the value to insert : ");
                scanf("%d", &value);
                insert(heap, value);
                }
                break;

            case 2:
                deleteMax(heap);
                break;

            case 3:
                display(heap);
                break;

            case 4:
                free(heap->arr);
                free(heap);
                printf("Exiting...\n");
                return 0;

            default:
                printf("Invalid choice! Please try again.\n");
        }
    }

    return 0;
}
